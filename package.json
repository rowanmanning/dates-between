{
  "name": "dates-between",
  "version": "6.1.1",
  "type": "module",
  "description": "Get all of the dates between two given dates",
  "keywords": [
    "between",
    "date",
    "generator"
  ],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanmanning/dates-between.git"
  },
  "homepage": "https://github.com/rowanmanning/dates-between",
  "bugs": "https://github.com/rowanmanning/dates-between/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "verify": "biome check",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 test/unit/**/*.test.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@rowanmanning/biome-config": "^3.1.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.ts"
  ]
}
