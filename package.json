{
  "name": "dates-between",
  "version": "6.1.1",
  "type": "module",
  "description": "Get all of the dates between two given dates",
  "keywords": [
    "between",
    "date",
    "generator"
  ],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanmanning/dates-between.git"
  },
  "homepage": "https://github.com/rowanmanning/dates-between",
  "bugs": "https://github.com/rowanmanning/dates-between/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "verify": "npm run verify:biome && npm run verify:types",
    "verify:biome": "biome check",
    "verify:types": "tsc --noEmit --project ./jsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 test/unit/**/*.test.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@rowanmanning/biome-config": "^3.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts"
}
